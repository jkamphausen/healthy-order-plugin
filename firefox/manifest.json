{
  "manifest_version": 3,
  "name": "Healthy Order",
  "version": "0.1.0",
  "description": "Research prototype: sorts categories on ubereats.com by healthiness and desaturates unhealthy ones. Not affiliated with Uber.",
  "browser_specific_settings": {
    "gecko": {
      "id": "healthy-order@research.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ubereats.com/*"
      ],
      "js": [
        "scores.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
