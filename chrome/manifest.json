{
  "manifest_version": 3,
  "name": "Healthy Order",
  "version": "0.1.0",
  "version_name": "0.1.0-alpha.1",
  "description": "Research prototype: sorts categories on ubereats.com by healthiness and desaturates unhealthy ones. Not affiliated with Uber.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ubereats.com/*"
      ],
      "js": [
        "scores.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
